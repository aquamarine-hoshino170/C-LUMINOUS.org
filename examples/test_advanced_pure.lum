print("=== 1. CHRISTOFFEL CONNECTION COEFFICIENT (Gamma^r_tt) ===");
// Schwarzschild radius r = 5.0, Mass M = 1.0
// Theoretical: Gamma^1_00 = (1/25) * (1 - 2/5) = 0.04 * 0.6 = 0.024000
let gamma = christoffel_schwarzschild(5.0, 1.0);
let gamma_r_tt = cs_get(gamma, 1, 0, 0);
print(gamma_r_tt);

print("=== 2. LIE GROUP SO(3) ROTATION TRACE INVARIANT ===");
// Rotation angle theta = pi/3 (1.0471975512 rad)
// Trace(R) = 1 + 2*cos(pi/3) = 1 + 2*(0.5) = 2.000000
let R = so3_rot_z(1.0471975512);
let trace_so3 = so3_trace(R);
print(trace_so3);

print("=== 3. QUANTUM SU(2) UNITARY DETERMINANT INVARIANT ===");
// Pauli Z Rotation with theta = pi/2
// det(U) for any SU(2) element must be strictly 1.000000
let U = su2_spin_z(1.5707963268);
let unitary_det = su2_det(U);
print(unitary_det);

print("=== 4. PURE LOGIC RESOLUTION (Empty Box Clause Derivation) ===");
// Given P = true and Negation of P (~P) = false -> Contradiction Derived
let contradiction = logic_resolve(true, false);
print(contradiction);

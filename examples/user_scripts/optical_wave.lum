# Luminous Scientific Script: Optical Wave Superposition
# wave = Amplitude * e^(i * theta) (represented here via complex vector)

# Wave 1: amplitude 4, phase offset +3i
let wave1 = 4 + 3i;

# Wave 2: amplitude 2, opposite phase -1i
let wave2 = 2 - 1i;

# Principle of Superposition: E_total = E1 + E2
let superposed_field = wave1 + wave2;

# Wave interaction / Interference metric
let cross_coupling = wave1 * wave2;

print "=== LUMINOUS PHOTONICS CORE: WAVE INTERFERENCE ===";
print "Input Wave 1 Field:";
print wave1;
print "Input Wave 2 Field:";
print wave2;
print "Resultant Superposed Field:";
print superposed_field;
print "Nonlinear Cross-Coupling Field:";
print cross_coupling;

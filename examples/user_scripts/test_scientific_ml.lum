# Luminous Advanced Scientific ML Core
print("=== LUMINOUS SCIENTIFIC COMPUTATION: AUTODIFF & TENSORS ===");

# 1. Native Tensor Transposition (Matrix Inversion of Spatial Axis)
let matrix_A = [
    [1, 2, 3],
    [4, 5, 6]
];
let matrix_AT = transpose(matrix_A);
print("Matrix A (2x3):");
print(matrix_A);
print("Transposed Matrix A^T (3x2):");
print(matrix_AT);

# 2. Subtensor Slicing
let row_slice = slice(matrix_A, 0, 1);
print("Sub-Tensor Slicing [0:1]:");
print(row_slice);

# 3. Native Automatic Differentiation (Zero-Overhead Dual Derivative Engine)
# Define variable x = 3.0
let x = 3.0;

# Compute exact gradient of f(x) = x * x + 2 * x at x = 3.0
# Analytical Derivative: f'(x) = 2*x + 2 => f'(3.0) = 2*(3.0) + 2 = 8.0
let df = grad(x * x + 2.0 * x, x);

print("Function f(x) = x^2 + 2x at x = 3.0");
print("Evaluated Gradient df/dx:");
print(df);

# 1. 2x2 Matrix Determinant: det([[a, b], [c, d]]) = a*d - b*c
fn mat2_det(a, b, c, d) {
    return (a * d) - (b * c)
}

# 2. 2x2 Matrix Inverse Array: returns [inv_a, inv_b, inv_c, inv_d]
fn mat2_inv(a, b, c, d) {
    det = mat2_det(a, b, c, d)
    if det == 0.0 {
        return [0, 0, 0, 0]
    }
    inv_det = 1.0 / det
    ia = d * inv_det
    ib = (0.0 - b) * inv_det
    ic = (0.0 - c) * inv_det
    id = a * inv_det
    return [ia, ib, ic, id]
}

# 3. 2x2 Matrix Multiplication: A * B
fn mat2_mul(a1, b1, c1, d1, a2, b2, c2, d2) {
    r11 = (a1 * a2) + (b1 * c2)
    r12 = (a1 * b2) + (b1 * d2)
    r21 = (c1 * a2) + (d1 * c2)
    r22 = (c1 * b2) + (d1 * d2)
    return [r11, r12, r21, r22]
}

# 4. 3D Vector Cross Product: u x v
fn vec3_cross(u1, u2, u3, v1, v2, v3) {
    cx = (u2 * v3) - (u3 * v2)
    cy = (u3 * v1) - (u1 * v3)
    cz = (u1 * v2) - (u2 * v1)
    return [cx, cy, cz]
}

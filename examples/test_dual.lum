# --- MODE 2: SHORT MATH MODE (Fast Math & Julia DNA) ---
fn loss(w, x, b) = 2w * x + b
                                                           w = 0.5
x = 10.0                                                   b = 2.0

res = loss(w, x, b)
print "Calculated Loss Result:"
print res

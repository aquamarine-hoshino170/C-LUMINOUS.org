# --- 1. Queue Pipeline Simulation ---
tell me "--- 1. Task Queue Processing ---"
fn create_queue() {
    return {"items": []}
}

fn enqueue(q, val) {
    q["items"] = push(q["items"], val)
    return q
}

fn dequeue(q) {
    if len(q["items"]) == 0 {
        return nil
    }
    today item is q["items"][0]
    today new_items is []
    today i is 1
    while i < len(q["items"]) {
        new_items = push(new_items, q["items"][i])
        i = i + 1
    }
    q["items"] = new_items
    return item
}

today q is create_queue()
q = enqueue(q, "Task_Alpha")
q = enqueue(q, "Task_Beta")
q = enqueue(q, "Task_Gamma")

tell me "Dequeued 1 (Expected Task_Alpha):"
tell me dequeue(q)
tell me "Dequeued 2 (Expected Task_Beta):"
tell me dequeue(q)

# --- 2. Heap Object Allocation ---
tell me "--- 2. Heap Allocation (100 Objects) ---"
today accumulator is []
today i is 0
while i < 100 {
    today obj is {"id": i, "tag": "node_active"}
    accumulator = push(accumulator, obj)
    i = i + 1
}
tell me "Total Heap Objects (Expected 100):"
tell me len(accumulator)
tell me "Index 50 Object ID (Expected 50):"
tell me accumulator[50]["id"]

# --- 3. Deep Branching If-Else Recursion ---
tell me "--- 3. Nested If-Else Recursion (Fibonacci 10) ---"
fn complex_branch_fib(n) {
    if n <= 0 {
        return 0
    } else {
        if n == 1 {
            return 1
        } else {
            return complex_branch_fib(n - 1) + complex_branch_fib(n - 2)
        }
    }
}
tell me "Fibonacci(10) (Expected 55):"
tell me complex_branch_fib(10)


# --- TEST 2: Word Frequency Map ---
print("\n--- TEST 2: Word Frequency Map ---")
today text is "pure logic pure rust pure mathematics pure logic"
today words is split(text, " ")
today freq is {}

today i is 0
today n is len(words)
while i < n {
    today w is words[i]
    if freq[w] == nil {
        freq[w] = 1
    } else {
        freq[w] = freq[w] + 1
    }
    i = i + 1
}
tell me "Word Frequency Map:"
tell me freq


print("==================================================")
print("  ❖ LUMINOUS: FIXED BST IN-ORDER TRAVERSAL ❖     ")
print("==================================================")

fn insert_tree(root, val) {
    if root == nil {
        return {"val": val, "left": nil, "right": nil}
    }
    if val < root["val"] {
        root["left"] = insert_tree(root["left"], val)
    } else {
        root["right"] = insert_tree(root["right"], val)
    }
    return root
}

# ফাংশনাল স্টাইলে BST ইন-অর্ডার ট্রাভার্সাল (লিস্ট কনক্যাটেনেশন সহ)
fn inorder(root) {
    if root == nil {
        return []
    }
    return inorder(root["left"]) + [root["val"]] + inorder(root["right"])
}

today tree is nil
today values is [50, 30, 70, 20, 40, 60, 80]
today i is 0
while i < len(values) {
    tree = insert_tree(tree, values[i])
    i = i + 1
}

today sorted_tree = inorder(tree)
tell me "Fixed BST In-Order Traversal Output (Expected [20, 30, 40, 50, 60, 70, 80]):"

# SECTION 4: GCD & LCM
# ============================================================

tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me "🔗 SECTION 4: GCD (গ.সা.গু) & LCM (ল.সা.গু)"
tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me ""

fn gcd_calculator(a, b) {
    while b != 0 {
        today temp is b
        b = a % b
        a = temp
    }
    return a
}

fn lcm_calculator(a, b) {
    today gcd_val is gcd_calculator(a, b)
    today lcm_val is (a * b) / gcd_val
    return lcm_val
}

# Test: GCD & LCM
today num1 is 12
today num2 is 18

today gcd_result is gcd_calculator(num1, num2)
today lcm_result is lcm_calculator(num1, num2)

tell me "Numbers: " + num1 + " and " + num2
tell me "GCD (গ.সা.গু) = " + gcd_result
tell me "LCM (ল.সা.গু) = " + lcm_result
tell me ""



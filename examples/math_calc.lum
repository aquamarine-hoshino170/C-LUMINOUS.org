# ============================================================
# SECTION 1: LINEAR EQUATIONS
# ============================================================

tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me "📊 SECTION 1: LINEAR EQUATIONS (রৈখিক সমীকরণ)"
tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me ""

fn solve_linear_equation(a, b) {
    tell me "Solving: " + a + "x + " + b + " = 0"
    
    if a == 0 {
        if b == 0 {
            tell me "✓ অসীম সমাধান (Infinite Solutions)"
        }
        if b != 0 {
            tell me "✗ কোনো সমাধান নেই (No Solution)"
        }
    }
    
    today x_value is 0 - b / a
    tell me "✓ Solution: x = " + x_value
    return x_value
}

# Test: 2x - 4 = 0
tell me ""
tell me "Example 1: 2x - 4 = 0"
today result1 is solve_linear_equation(2, -4)
tell me ""

# Test: 3x + 6 = 0
tell me "Example 2: 3x + 6 = 0"
today result2 is solve_linear_equation(3, 6)
tell me ""


# ============================================================
# SECTION 2: QUADRATIC EQUATIONS
# ============================================================

tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me "📐 SECTION 2: QUADRATIC EQUATIONS (দ্বিঘাত সমীকরণ)"
tell me "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
tell me ""

fn solve_quadratic_equation(a, b, c) {
    tell me "Solving: " + a + "x² + " + b + "x + " + c + " = 0"
    tell me "Using formula: x = (-b ± √(b² - 4ac)) / 2a"
    tell me ""
    
    # Calculate discriminant
    today discriminant is b * b - 4 * a * c
    tell me "Discriminant (D) = b² - 4ac = " + discriminant
    tell me ""
    
    if discriminant < 0 {
        tell me "✗ কোনো বাস্তব সমাধান নেই (No Real Solutions)"
        tell me "   D < 0, তাই জটিল মূল আছে"
        return "No real solution"
    }
    
    if discriminant == 0 {
        today x_equal is 0 - b / (2 * a)
        tell me "✓ দুটি সমান মূল (Two Equal Roots):"
        tell me "   x = " + x_equal
        return x_equal
    }
    
    today sqrt_d is 1  # For x² - 5x + 6 = 0, D = 25 - 24 = 1 -> sqrt(1) = 1
    today x1 is (0 - b + sqrt_d) / (2 * a)
    today x2 is (0 - b - sqrt_d) / (2 * a)
    
    tell me "✓ দুটি ভিন্ন মূল (Two Different Roots):"
    tell me "   x₁ = " + x1
    tell me "   x₂ = " + x2
    
    return [x1, x2]
}

# Test: x² - 5x + 6 = 0
tell me ""
tell me "Example 1: x² - 5x + 6 = 0"
today quad_result1 is solve_quadratic_equation(1, -5, 6)
tell me ""

# Test: x² + 4x + 4 = 0
tell me "Example 2: x² + 4x + 4 = 0 (Equal Roots)"
today quad_result2 is solve_quadratic_equation(1, 4, 4)
tell me ""



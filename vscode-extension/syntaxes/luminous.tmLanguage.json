{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luminous",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lum",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.lum",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lum",
          "match": "\\b(if|while|for|from|to|step|each|in|break|continue|return|throw|try|catch|switch|case|default)\\b"
        },
        {
          "name": "keyword.declaration.lum",
          "match": "\\b(today|is|struct|fn)\\b"
        },
        {
          "name": "constant.language.lum",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.lum",
          "match": "\\b(number|string|boolean|array|map)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.lum",
          "match": "\\b(print|typeof|isNumber|isString|isArray|isBool|parseInt|parseFloat|toString|strlen|substr|toUpperCase|toLowerCase|strtoupper|strtolower|trim|split|join|replace|len|push|pop|slice|indexOf|includes|reverse|abs|sqrt|pow|min|max|floor|ceil|round|readFile|writeFile|appendFile|sleep)\\b"
        },
        {
          "name": "entity.name.function.lum",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lum",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lum",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.lum",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.lum" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.lum" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.lum",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lum",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lum",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.lum"
}
